#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

PROG=/usr/sbin/station
CONFDIR=/etc/basicstation

start_service() {
	if [ ! -f "$CONFDIR/station.conf" ] && [ ! -f "$CONFDIR/tc.uri" ]; then
		echo "basicstation: no config found in $CONFDIR, not starting"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param file "$CONFDIR/"
	procd_set_param env HOME="$CONFDIR"
	procd_set_param chdir "$CONFDIR"
	procd_set_param respawn 300 5 -1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall station 2>/dev/null
}
